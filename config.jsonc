[
    {
        "name": "strip",
        "layer": "overlay",
        "position": "top",
        "exclusive": false,
        "passthrough": true,
        "height": 0,
        "spacing": 0,
        "margin": 0,

        "modules-left": [],
        "modules-center": ["custom/mem", "clock", "cpu"],
        "modules-right": [],

        "custom/mem": {
            "exec": "~/.config/waybar/scripts/mem.sh",
            "interval": 2,
            "min-length": 13,
            "tooltip": false
        },
        "clock": {
            "interval": 1,
            "format": "time: {:%H:%M}",
            "tooltip": false
        },
        "cpu": {
            "interval": 2,
            "format": "cpu: {usage}%",
            "min-length": 9,
            "tooltip": false
        }
    },
    {
        "name": "tags",
        "layer": "overlay",
        "position": "left",
        "exclusive": false,
        "width": 0,
        "spacing": 0,
        "margin": 0,
        "modules-left": [],
        "modules-right": [],
        "include": ["~/.config/waybar/workspaces.jsonc"]
    }
]
